{% extends "_layouts/cp" %}
{% import "_includes/forms.twig" as forms %}

{% set title = isNew ? "New catalog source"|t('bee') : source.name %}
{% set selectedSubnavItem = 'catalog' %}
{% set crumbs = [
  { label: "Bee"|t('bee'), url: url('bee/catalog') },
  { label: "Catalog"|t('bee'), url: url('bee/catalog') },
] %}
{% set fullPageForm = not readOnly %}

{% block content %}
  {% include 'bee/_styles' %}


  {% if adminChangesOff %}
    <div class="pane">
      <p class="light">{{ "Sources live in project config, which is read-only because allowAdminChanges is off. Change this in an environment where admin changes are allowed, and deploy it."|t('bee') }}</p>
    </div>
  {% elseif readOnly %}
    <div class="pane">
      <p class="light">{{ "Only admins can add or change sources, because they live in project config and can run Twig."|t('bee') }}</p>
    </div>
  {% endif %}

  <input type="hidden" name="action" value="bee/catalog/save-source">
  {{ redirectInput('bee/catalog') }}
  {% if not isNew %}<input type="hidden" name="uid" value="{{ source.uid }}">{% endif %}

  {{ forms.textField({
    first: true,
    label: "Name"|t('bee'),
    id: 'name',
    name: 'name',
    value: source.name,
    required: true,
    errors: source.getErrors('name'),
    disabled: readOnly,
  }) }}

  {{ forms.selectField({
    label: "Element type"|t('bee'),
    id: 'elementType',
    name: 'elementType',
    options: elementTypeOptions,
    value: source.elementType,
    errors: source.getErrors('elementType'),
    disabled: readOnly,
  }) }}

  {#
    The scope depends on the element type, so every type's scope is rendered and the one that
    matches the select is shown (GitHub #5). The others are disabled as well as hidden, so they
    are never posted.
  #}
  {% for option in elementTypeOptions %}
    {% set scope = scopeOptions[option.value] %}
    {% set isCurrent = option.value == source.elementType %}
    {% set isUserSource = option.value == 'craft\\elements\\User' %}
    <div data-bee-scope="{{ option.value }}"{% if not isCurrent %} hidden{% endif %}>
      {% if isUserSource %}
        <div class="pane">
          <p class="light">{{ "Users are sent to Recombee as items, with their full name as the title and whatever properties you map below — map only what you would be comfortable sharing with Recombee. Only active users are synced, and users are never returned by the public JSON recommendation endpoint; show them with `craft.bee.recommend()` in your own templates."|t('bee') }}</p>
        </div>
      {% endif %}

      {% if scope.groups|length %}
        {{ forms.checkboxSelectField({
          label: isUserSource ? "User groups"|t('bee') : "Scope"|t('bee'),
          instructions: isUserSource
            ? "A user in any of the checked groups is included. Leave everything unchecked to include every user."|t('bee')
            : "Leave everything unchecked to include all of them."|t('bee'),
          id: 'groupUids-' ~ loop.index,
          name: 'groupUids',
          options: scope.groups,
          values: isCurrent ? source.groupUids : [],
          disabled: readOnly or not isCurrent,
        }) }}
      {% endif %}

      {% if scope.types|length %}
        {{ forms.checkboxSelectField({
          label: "Entry types"|t('bee'),
          instructions: "Leave everything unchecked to include all of them."|t('bee'),
          id: 'typeUids-' ~ loop.index,
          name: 'typeUids',
          options: scope.types,
          values: isCurrent ? source.typeUids : [],
          disabled: readOnly or not isCurrent,
        }) }}
      {% endif %}
    </div>
  {% endfor %}

  {% if not readOnly %}
    {% js %}
      (() => {
        const select = document.getElementById('elementType');
        const show = () => {
          document.querySelectorAll('[data-bee-scope]').forEach(scope => {
            const current = scope.dataset.beeScope === select.value;
            scope.hidden = !current;
            scope.querySelectorAll('input').forEach(input => { input.disabled = !current; });
          });
        };
        select.addEventListener('change', show);
        show();
      })();
    {% endjs %}
  {% endif %}

  {{ forms.lightswitchField({
    label: "Enabled"|t('bee'),
    id: 'enabled',
    name: 'enabled',
    on: source.enabled,
    disabled: readOnly,
  }) }}

  {{ forms.lightswitchField({
    label: "Live elements only"|t('bee'),
    instructions: "Disabled, expired and pending elements are removed from Recombee instead of being sent. Leave this on unless you filter on status yourself."|t('bee'),
    id: 'liveOnly',
    name: 'liveOnly',
    on: source.liveOnly,
    disabled: readOnly,
  }) }}

  <hr>

  <h2>{{ "Properties"|t('bee') }}</h2>
  <p class="light">
    {{ "Bee always sends title, url, imageUrl, itemType, siteId, sourceHandle, slug, enabled, postDate, expiryDate and updatedAt. Everything below is on top of those."|t('bee') }}
  </p>
  <p class="light">
    {{ "Property names are shared across the whole Recombee database, so two sources that both send “price” have to agree on its type."|t('bee') }}
  </p>

  {{ forms.editableTableField({
    label: "Mappings"|t('bee'),
    id: 'properties',
    name: 'properties',
    cols: {
      name: { heading: "Recombee property"|t('bee'), type: 'singleline', class: 'code', width: '22%' },
      type: { heading: "Type"|t('bee'), type: 'select', options: propertyTypeOptions, width: '16%' },
      kind: { heading: "Read from"|t('bee'), type: 'select', options: kindOptions, width: '16%' },
      value: { heading: "Field handle, attribute, mapper key or Twig"|t('bee'), type: 'singleline', class: 'code' },
      enabled: { heading: "On"|t('bee'), type: 'checkbox', thin: true },
    },
    rows: source.properties|map(p => {
      name: p.name,
      type: p.type,
      kind: p.kind,
      value: p.value,
      enabled: p.enabled,
    }),
    addRowLabel: "Add a property"|t('bee'),
    errors: source.getErrors('properties'),
    allowAdd: not readOnly,
    allowDelete: not readOnly,
    allowReorder: not readOnly,
    static: readOnly,
  }) }}

  <div class="pane">
    <h3>{{ "Built-in mappers"|t('bee') }}</h3>
    <p class="light">{{ "Set “Read from” to “Built-in mapper” and use one of these keys."|t('bee') }}</p>
    <table class="data fullwidth">
      <tbody>
        {% for key, label in specialOptions %}
          <tr>
            <td class="code bee-key-col">{{ key }}</td>
            <td class="light">{{ label }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="pane">
    <h3>{{ "Twig mappings"|t('bee') }}</h3>
    <p class="light">
      {{ "Rendered as an object template with the element in scope, e.g."|t('bee') }}
      <code>{% verbatim %}{{ object.author.fullName }}{% endverbatim %}</code>.
      {{ "For a set or an image list, output a JSON array or one value per line — e.g."|t('bee') }}
      <code>{% verbatim %}{{ myValues(object)|json_encode }}{% endverbatim %}</code>
      {{ "or"|t('bee') }}
      <code>{% verbatim %}{{ myValues(object)|join("\n") }}{% endverbatim %}</code>.
      {{ "An array printed directly can’t be turned into text, so the property would be left out."|t('bee') }}
    </p>
  </div>

{% endblock %}
